# Backend base URL (no trailing slash, no /api/v1 — the client appends it).
#
# Preferred over `expo.extra.apiBaseUrl` in app.json during development:
# Metro inlines EXPO_PUBLIC_* at bundle time, so a dev-server restart is enough,
# whereas app.json `extra` is baked into the native binary and needs a rebuild.
#
# iOS simulator      → http://localhost:8787
# Android emulator   → http://10.0.2.2:8787
# Physical device    → http://<your-lan-ip>:8787
EXPO_PUBLIC_API_URL=http://localhost:8787
