  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.18",
    "jest": "~29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-pretext",
          "react-native-nitro-fetch",
          "react-native-nitro-text-decoder",
          "react-native-nitro-websockets"
        ]
      }
    }
  }
}
