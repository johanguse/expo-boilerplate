{
  "name": "expo-boilerplate",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "jest --passWithNoTests",
    "pb": "expo prebuild",
    "pb:c": "expo prebuild --clean",
    "pb:i": "expo prebuild --clean --platform ios",
    "pb:a": "expo prebuild --clean --platform android",
    "rename-app": "bun run scripts/rename-app.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@legendapp/list": "^3.3.10",
    "@react-native-firebase/analytics": "^24.1.1",
    "@react-native-firebase/app": "^24.1.1",
    "@react-native-firebase/crashlytics": "^24.1.1",
    "@react-native-firebase/messaging": "^24.1.1",
    "@react-native-firebase/perf": "^24.1.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "date-fns": "^4.4.0",
    "expo": "^57.0.20",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-observe": "~57.0.19",
    "expo-pretext": "^1.2.0",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "heroui-native": "^1.0.9",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.13",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "^4.3.2",
    "react-native-modern-shimmer": "^1.1.8",
    "react-native-nano-icons": "^0.2.1",
    "react-native-nitro-fetch": "^1.6.3",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-nitro-text-decoder": "^0.2.0",
    "react-native-nitro-websockets": "^1.3.1",
    "react-native-notify-kit": "^10.7.0",
    "react-native-permission-handler": "^0.8.2",
    "react-native-permissions": "^5.6.1",
    "react-native-purchases": "^10.9.0",
    "react-native-purchases-ui": "^10.9.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
